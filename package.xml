<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>enpose_tracking</name>
  <version>0.1.0</version>
  <description>ROS2 node for the Enpose 6-DoF optical marker tracking system.
    Connects to an Enpose sensor, streams marker poses, and publishes them as
    PoseStamped messages and TF transforms.</description>
  <maintainer email="info@enpose.tech">Enpose</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The build compiles the enpose-api Rust SDK from source: cargo (which
       pulls rustc) builds it, and git is used by FetchContent to fetch it. -->
  <build_depend>cargo</build_depend>
  <build_depend>git</build_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
